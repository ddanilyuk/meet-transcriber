{
  "manifest_version": 3,
  "name": "Meet Transcriber",
  "version": "1.1.2",
  "description": "Зберігає субтитри Google Meet (українською) локально, з іменами мовців.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Meet Transcriber — архів мітингів",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "downloads", "alarms", "scripting"],
  "host_permissions": ["https://meet.google.com/*", "http://localhost:8765/*"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/page-raf.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "shared/icons.js",
        "shared/util.js",
        "shared/strings.js",
        "shared/transcript.js",
        "shared/format.js",
        "content/selectors.js",
        "content/meet-dom.js",
        "content/caption-tracker.js",
        "content/captions-control.js",
        "content/session.js",
        "content/sidebar/templates.js",
        "content/sidebar/sidebar.js",
        "content/main.js"
      ],
      "css": ["content/page.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/sidebar/sidebar.css"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
